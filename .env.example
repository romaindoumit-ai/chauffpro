# Copiez ce fichier en .env pour tester sur votre ordinateur (facultatif).
BASE_URL=http://localhost:3000
APP_NAME=ChauffPro
ADMIN_EMAIL=vous@exemple.fr
ADMIN_PASSWORD=choisissez-un-mot-de-passe
# Sans clé Brevo, l'application fonctionne en « mode simulation » (rien n'est envoyé).
BREVO_API_KEY=
EMAIL_FROM=notifications@votredomaine.fr
# Optionnel : Twilio pour le message vocal des appels manqués / l'envoi des SMS
# SMS_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=
DATABASE_FILE=./data/chauffapp.db
INBOUND_KEY=
